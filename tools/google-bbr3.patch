diff --git a/net/ipv4/tcp_input.c b/net/ipv4/tcp_input.c
index 27af85a6791e..6090fb17a758 100644
--- a/net/ipv4/tcp_input.c
+++ b/net/ipv4/tcp_input.c
@@ -1762,7 +1762,7 @@ static void tcp_rate_gen(struct sock *sk, u32 delivered, u32 lost,
 	 * longer phase.
